# Browser-safe Supabase credentials only. Never put SUPABASE_SECRET_KEY here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Optional API origin. Leave unset for the same-origin PHP API (and the Vite development proxy).
# VITE_API_BASE_URL=https://hr.example.com
